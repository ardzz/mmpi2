{
  "name": "@mmpi2/reports",
  "version": "0.0.1",
  "private": true,
  "description": "Report data models, chart transformations, PDF composition templates",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "biome lint ./src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@mmpi2/contracts": "workspace:*",
    "@react-pdf/renderer": "^4.1.6",
    "react": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "*",
    "@mmpi2/tooling": "workspace:*",
    "@types/react": "^18.3.18",
    "rimraf": "*",
    "typescript": "*",
    "vitest": "^2.1.8"
  }
}
