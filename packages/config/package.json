{
  "name": "@mmpi2/config",
  "version": "0.0.1",
  "private": true,
  "description": "Versioned MMPI-2 question bank, scoring config, thresholds, and reference data",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "biome lint ./src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@biomejs/biome": "*",
    "@mmpi2/tooling": "workspace:*",
    "rimraf": "*",
    "typescript": "*",
    "vitest": "^2.1.8"
  }
}
