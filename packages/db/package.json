{
  "name": "@mmpi2/db",
  "version": "0.0.1",
  "private": true,
  "description": "Prisma schema, generated client, migration helpers, and seed utilities",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "biome lint ./src",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx src/seed/index.ts",
    "db:studio": "prisma studio",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@mmpi2/config": "workspace:*",
    "@prisma/client": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "*",
    "@mmpi2/tooling": "workspace:*",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "rimraf": "*",
    "tsx": "^4.19.2",
    "typescript": "*"
  }
}
