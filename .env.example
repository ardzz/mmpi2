# =============================================================================
# MMPI-2 Platform — Local Development Environment Variables
# Copy to .env and adjust as needed:  cp .env.example .env
# =============================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=mmpi2
POSTGRES_PASSWORD=mmpi2_local
POSTGRES_DB=mmpi2
DATABASE_URL=postgresql://mmpi2:mmpi2_local@postgres:5432/mmpi2?schema=public

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- MinIO (S3-compatible object storage) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=mmpi2-reports
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---------- API ----------
API_PORT=3001
NODE_ENV=development
JWT_SECRET=local-dev-jwt-secret-change-me

# ---------- Worker ----------
# Worker connects to Redis for BullMQ and PostgreSQL for DB access.
# Same DATABASE_URL and REDIS_URL apply.

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:3001/api
